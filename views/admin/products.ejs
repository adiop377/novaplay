<div class="admin-actions">
    <a href="/admin/products/new" class="btn btn-primary">➕ Add New Product</a>
</div>

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Image</th>
                <th>Title</th>
                <th>Rank</th>
                <th>Price</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (products && products.length> 0) { %>
                <% products.forEach(function(product) { %>
                    <tr>
                        <td>#<%= product.id %>
                        </td>
                        <td>
                            <% if (product.cover_image) { %>
                                <img src="<%= product.cover_image %>" alt="" class="table-thumb">
                            <% } else if (product.images && product.images.length > 0) { %>
                                <img src="<%= product.images[0] %>" alt="" class="table-thumb">
                            <% } else { %>
                                <div class="table-thumb-placeholder">📷</div>
                            <% } %>
                        </td>
                        <td>
                            <%= product.title %>
                        </td>
                        <td><span class="rank-badge">
                                <%= product.rank %>
                            </span></td>
                        <td>
                            <% let finalPrice = parseFloat(product.price) - parseFloat(product.discount || 0); %>
                            <span style="font-weight: 700; color: #fff;">₹<%= finalPrice.toLocaleString('en-IN') %></span>
                            <% if (product.discount > 0) { %>
                                <div style="font-size: 0.7rem; color: rgba(255,255,255,0.3); text-decoration: line-through; margin-top: 2px;">
                                    ₹<%= parseFloat(product.price).toLocaleString('en-IN') %>
                                </div>
                            <% } %>
                        </td>
                        <td>
                            <% if (product.is_sold) { %>
                                <span class="status-badge sold">Sold</span>
                                <% } else { %>
                                    <span class="status-badge available">Available</span>
                                    <% } %>
                        </td>
                        <td class="actions">
                            <a href="/admin/products/<%= product.id %>/edit" class="action-btn edit">✏️</a>
                            <form action="/admin/products/<%= product.id %>/delete" method="POST" style="display:inline"
                                onsubmit="return confirm('Are you sure?')">
                                <button type="submit" class="action-btn delete">🗑️</button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 40px;">No products found. Add your
                                    first product!</td>
                            </tr>
                            <% } %>
        </tbody>
    </table>
</div>