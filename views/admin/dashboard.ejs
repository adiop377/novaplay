<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/socket.io/socket.io.js"></script>

<style>
    :root {
        --bg-dark: #0f141c;
        --card-bg: rgba(20, 25, 35, 0.95);
        --neon-blue: #00e5ff;
        --neon-green: #00ff66;
        --neon-purple: #bc13fe;
        --text-main: #e2e8f0;
        --glass-border: rgba(255, 255, 255, 0.08);
    }
    
    .admin-dashboard-wrapper {
        font-family: 'Rajdhani', sans-serif;
        color: var(--text-main);
        padding: 20px 0;
    }

    .grid-top {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 25px;
    }

    .live-card {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.5);
        position: relative;
        overflow: hidden;
    }

    .live-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; width: 100%; height: 4px;
        background: linear-gradient(90deg, var(--neon-blue), var(--neon-purple));
    }

    .live-card.green-glow::before { background: linear-gradient(90deg, var(--neon-green), #00aaff); }
    .live-card.yellow-glow::before { background: linear-gradient(90deg, #ffd700, #ff8c00); }
    .live-card.red-glow::before { background: linear-gradient(90deg, #ff3366, #ff00cc); }

    .card-title {
        font-size: 1.1rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .card-value {
        font-size: 2.8rem;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        color: #fff;
        line-height: 1.2;
    }

    .live-pulse {
        position: absolute;
        top: 20px; right: 20px;
        width: 12px; height: 12px;
        background: #ff3366;
        border-radius: 50%;
        animation: pulse 2s infinite ease-in-out;
    }

    @keyframes pulse {
        0% { transform: scale(0.9); opacity: 0.7; }
        50% { transform: scale(1.2); opacity: 1; }
        100% { transform: scale(0.9); opacity: 0.7; }
    }

    .main-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 25px;
        margin-bottom: 25px;
    }

    .chart-container {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 20px;
    }

    .activity-feed {
        background: var(--card-bg);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 20px;
        height: 100%;
        max-height: 400px;
        overflow-y: auto;
    }

    .feed-item {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        font-size: 1.05rem;
    }

    .feed-item:last-child { border: none; }

    .feed-time { color: var(--neon-blue); font-family: monospace; font-size: 0.9rem; }
    .feed-user { font-weight: 700; color: #fff; }
    .feed-action { color: #94a3b8; }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
    }

    .progress-bar-wrapper {
        margin-top: 15px;
    }
    
    .progress-label {
        display: flex; justify-content: space-between; margin-bottom: 5px; font-size: 0.95rem; font-weight: 600;
    }

    .progress-bar {
        width: 100%; height: 8px; background: rgba(255,255,255,0.1); border-radius: 10px; overflow: hidden;
    }
    
    .progress-fill {
        height: 100%; border-radius: 10px; transition: width 0.5s ease;
    }

    @media (max-width: 992px) {
        .main-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="admin-dashboard-wrapper">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-wrap: wrap; gap: 15px;">
        <h2 style="margin: 0; font-size: 2rem; text-transform: uppercase; font-family: 'Orbitron', monospace;">Live Command Center</h2>
        <div style="display: flex; align-items: center; gap: 10px; background: rgba(0, 255, 102, 0.1); padding: 8px 15px; border-radius: 10px; border: 1px solid rgba(0, 255, 102, 0.3);">
            <div style="width: 10px; height: 10px; background: #00ff66; border-radius: 50%; box-shadow: 0 0 10px #00ff66;"></div>
            <span style="color: #00ff66; font-weight: 700; font-size: 1.1rem;">SYSTEM ONLINE</span>
        </div>
    </div>

    <!-- Top Stats -->
    <div class="grid-top">
        <div class="live-card red-glow">
            <div class="live-pulse"></div>
            <div class="card-title">Live Website Visitors</div>
            <div class="card-value" id="val-active-visitors">--</div>
            <div style="color: #ff3366; font-size: 0.9rem; margin-top: 5px; font-weight: 600;">Currently on site</div>
        </div>
        <div class="live-card green-glow">
            <div class="card-title">Online Users (Logged In)</div>
            <div class="card-value" id="val-online-users">--</div>
            <div style="color: #00ff66; font-size: 0.9rem; margin-top: 5px; font-weight: 600;">Active Sessions</div>
        </div>
        <div class="live-card">
            <div class="card-title">Today's Revenue</div>
            <div class="card-value" style="color: var(--neon-blue);">₹<span id="val-today-revenue"><%= parseFloat(orderStats.total_revenue || 0).toLocaleString('en-IN') %></span></div>
        </div>
        <div class="live-card yellow-glow">
            <div class="card-title">Today's Orders</div>
            <div class="card-value" style="color: #ffd700;" id="val-today-orders"><%= orderStats.total_orders %></div>
        </div>
    </div>

    <!-- Charts & Feed -->
    <div class="main-grid">
        <div class="activity-feed">
            <h3 style="margin-bottom: 20px; font-size: 1.3rem; font-family: 'Orbitron', monospace; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;">⚡ Live Activity Feed</h3>
            <div id="activity-container">
                <div style="text-align: center; color: #64748b; padding: 20px;">Waiting for activity...</div>
            </div>
        </div>
    </div>

    <!-- Detailed Analytics Grid -->
    <div class="stats-grid">
        <!-- Device Info -->
        <div class="chart-container">
            <h3 style="margin-bottom: 15px; font-size: 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;">📱 Device Information</h3>
            <div class="progress-bar-wrapper">
                <div class="progress-label"><span>Mobile</span> <span id="val-mobile">0%</span></div>
                <div class="progress-bar"><div id="bar-mobile" class="progress-fill" style="width: 0%; background: #ff3366;"></div></div>
            </div>
            <div class="progress-bar-wrapper">
                <div class="progress-label"><span>Desktop</span> <span id="val-desktop">0%</span></div>
                <div class="progress-bar"><div id="bar-desktop" class="progress-fill" style="width: 0%; background: #00e5ff;"></div></div>
            </div>
            <div class="progress-bar-wrapper">
                <div class="progress-label"><span>Tablet</span> <span id="val-tablet">0%</span></div>
                <div class="progress-bar"><div id="bar-tablet" class="progress-fill" style="width: 0%; background: #ffd700;"></div></div>
            </div>
        </div>

        <!-- Browser Info -->
        <div class="chart-container">
            <h3 style="margin-bottom: 15px; font-size: 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;">🌐 Browser Analytics</h3>
            <div class="progress-bar-wrapper">
                <div class="progress-label"><span>Chrome</span> <span id="val-chrome">0%</span></div>
                <div class="progress-bar"><div id="bar-chrome" class="progress-fill" style="width: 0%; background: #00ff66;"></div></div>
            </div>
            <div class="progress-bar-wrapper">
                <div class="progress-label"><span>Safari</span> <span id="val-safari">0%</span></div>
                <div class="progress-bar"><div id="bar-safari" class="progress-fill" style="width: 0%; background: #bc13fe;"></div></div>
            </div>
            <div class="progress-bar-wrapper">
                <div class="progress-label"><span>Firefox/Other</span> <span id="val-firefox">0%</span></div>
                <div class="progress-bar"><div id="bar-firefox" class="progress-fill" style="width: 0%; background: #ff8c00;"></div></div>
            </div>
        </div>

        <!-- System Status & Actions -->
        <div class="chart-container" style="background: linear-gradient(135deg, rgba(0,229,255,0.1), rgba(0,0,0,0.4));">
            <h3 style="margin-bottom: 15px; font-size: 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;">⚙️ Quick System Actions</h3>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px;">
                <a href="/admin/orders" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 12px; text-align: center; border-radius: 8px; text-decoration: none; font-weight: 600; transition: background 0.3s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='rgba(255,255,255,0.05)'">Manage Orders</a>
                <a href="/admin/products" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 12px; text-align: center; border-radius: 8px; text-decoration: none; font-weight: 600; transition: background 0.3s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='rgba(255,255,255,0.05)'">Products</a>
                <a href="/admin/users" style="background: rgba(255,215,0,0.1); border: 1px solid rgba(255,215,0,0.3); color: #ffd700; padding: 12px; text-align: center; border-radius: 8px; text-decoration: none; font-weight: 600; transition: background 0.3s; grid-column: span 2;" onmouseover="this.style.background='rgba(255,215,0,0.2)'" onmouseout="this.style.background='rgba(255,215,0,0.1)'">Manage Users & Coins</a>
            </div>
            
            <h3 style="margin-bottom: 10px; font-size: 1.1rem;">Website Status</h3>
            <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(0,255,102,0.05); padding: 10px; border-radius: 8px; border: 1px solid rgba(0,255,102,0.2);">
                <span style="color: #94a3b8; font-weight: 600;">Main Server</span>
                <span style="color: #00ff66; font-weight: 700;">Healthy</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(0,255,102,0.05); padding: 10px; border-radius: 8px; border: 1px solid rgba(0,255,102,0.2); margin-top: 8px;">
                <span style="color: #94a3b8; font-weight: 600;">Database</span>
                <span style="color: #00ff66; font-weight: 700;">Connected</span>
            </div>
        </div>
    </div>

    <!-- Extra Tables Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 25px; margin-top: 25px;">
        <!-- User Locations -->
        <div class="chart-container">
            <h3 style="margin-bottom: 15px; font-size: 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;">🌍 Live User Locations</h3>
            <div id="location-container" style="max-height: 200px; overflow-y: auto;">
                <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <span style="color: #fff;">Mumbai, MH, India</span><span style="color: var(--neon-blue);">12 users</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <span style="color: #fff;">Delhi, DL, India</span><span style="color: var(--neon-blue);">8 users</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 8px 0;">
                    <span style="color: #fff;">Bangalore, KA, India</span><span style="color: var(--neon-blue);">5 users</span>
                </div>
            </div>
        </div>

        <!-- Payment Status Summary -->
        <div class="chart-container">
            <h3 style="margin-bottom: 15px; font-size: 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;">💳 Payment Status Summary</h3>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div style="background: rgba(255, 215, 0, 0.1); padding: 15px; border-radius: 8px; border: 1px solid rgba(255, 215, 0, 0.3); text-align: center;">
                    <div style="color: #ffd700; font-size: 1.8rem; font-weight: 800;"><%= orderStats.pending_orders %></div>
                    <div style="color: #94a3b8; font-size: 0.85rem; text-transform: uppercase;">Pending</div>
                </div>
                <div style="background: rgba(0, 255, 102, 0.1); padding: 15px; border-radius: 8px; border: 1px solid rgba(0, 255, 102, 0.3); text-align: center;">
                    <div style="color: #00ff66; font-size: 1.8rem; font-weight: 800;"><%= orderStats.confirmed_orders %></div>
                    <div style="color: #94a3b8; font-size: 0.85rem; text-transform: uppercase;">Confirmed</div>
                </div>
                <div style="background: rgba(0, 229, 255, 0.1); padding: 15px; border-radius: 8px; border: 1px solid rgba(0, 229, 255, 0.3); text-align: center; grid-column: span 2;">
                    <div style="color: #00e5ff; font-size: 1.8rem; font-weight: 800;"><%= orderStats.delivered_orders %></div>
                    <div style="color: #94a3b8; font-size: 0.85rem; text-transform: uppercase;">Delivered</div>
                </div>
            </div>
        </div>

        <!-- Top Selling Products -->
        <div class="chart-container">
            <h3 style="margin-bottom: 15px; font-size: 1.2rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px;">🔥 Top Selling Products</h3>
            <div style="max-height: 200px; overflow-y: auto;">
                <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <span style="color: #fff;">Free Fire Max Premium Account</span><span style="color: var(--neon-green);">34 Sales</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <span style="color: #fff;">1000 Nova Coins Pack</span><span style="color: var(--neon-green);">28 Sales</span>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 8px 0;">
                    <span style="color: #fff;">VIP Royale ID (Level 70)</span><span style="color: var(--neon-green);">15 Sales</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    // Connect Socket.IO
    const socket = io('/admin');
    const activityContainer = document.getElementById('activity-container');

    socket.on('connect', () => {
        console.log('Connected to Live Admin Socket');
    });

    socket.on('dashboardData', (data) => {
        // Update top widgets
        document.getElementById('val-active-visitors').innerText = data.activeVisitors;
        document.getElementById('val-online-users').innerText = data.onlineUsers;
        
        document.getElementById('val-today-revenue').innerText = data.todayRevenue.toLocaleString('en-IN');
        document.getElementById('val-today-orders').innerText = data.todayOrders;

        // Update Device Bars
        document.getElementById('bar-mobile').style.width = data.deviceStats.mobile + '%';
        document.getElementById('val-mobile').innerText = data.deviceStats.mobile + '%';
        document.getElementById('bar-desktop').style.width = data.deviceStats.desktop + '%';
        document.getElementById('val-desktop').innerText = data.deviceStats.desktop + '%';
        document.getElementById('bar-tablet').style.width = data.deviceStats.tablet + '%';
        document.getElementById('val-tablet').innerText = data.deviceStats.tablet + '%';

        // Update Browser Bars
        document.getElementById('bar-chrome').style.width = data.browserStats.chrome + '%';
        document.getElementById('val-chrome').innerText = data.browserStats.chrome + '%';
        document.getElementById('bar-safari').style.width = data.browserStats.safari + '%';
        document.getElementById('val-safari').innerText = data.browserStats.safari + '%';
        let firefoxOther = data.browserStats.firefox + data.browserStats.other;
        document.getElementById('bar-firefox').style.width = firefoxOther + '%';
        document.getElementById('val-firefox').innerText = firefoxOther + '%';

        // Prepend new activities
        if(data.activities && data.activities.length > 0) {
            if(activityContainer.innerHTML.includes('Waiting')) activityContainer.innerHTML = '';
            
            data.activities.forEach(act => {
                const actDiv = document.createElement('div');
                actDiv.className = 'feed-item';
                
                let icon = '⚡';
                if(act.action.includes('cart')) icon = '🛒';
                if(act.action.includes('checkout')) icon = '💳';
                if(act.action.includes('logged in')) icon = '🔑';

                actDiv.innerHTML = `
                    <div style="display:flex; gap: 10px; align-items: center;">
                        <span>${icon}</span>
                        <div>
                            <span class="feed-user">${act.user}</span> 
                            <span class="feed-action">${act.action}</span>
                        </div>
                    </div>
                    <span class="feed-time">${act.time}</span>
                `;
                activityContainer.prepend(actDiv);
            });

            // Keep max 20 items
            while(activityContainer.children.length > 20) {
                activityContainer.removeChild(activityContainer.lastChild);
            }
        }
    });
</script>