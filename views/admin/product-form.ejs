<div class="admin-form-container">
    <form id="adminProductForm" action="<%= isEdit ? '/admin/products/' + product.id : '/admin/products' %>" method="POST"
        enctype="multipart/form-data" class="admin-form">

        <div class="form-row">
            <div class="form-group">
                <label for="title">Product Title *</label>
                <input type="text" id="title" name="title" value="<%= isEdit ? product.title : '' %>" required
                    placeholder="e.g., Grandmaster | Level 78">
            </div>
            <div class="form-group">
                <label for="tag">Tag</label>
                <input type="text" id="tag" name="tag" value="<%= isEdit ? (product.tag || '') : '' %>"
                    placeholder="e.g., RARE BUNDLE">
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="rank">Rank *</label>
                <select id="rank" name="rank" required>
                    <option value="">Select Rank</option>
                    <option value="Grandmaster" <%=isEdit && product.rank==='Grandmaster' ? 'selected' : '' %>>Grandmaster</option>
                    <option value="Master" <%=isEdit && product.rank==='Master' ? 'selected' : '' %>>Master</option>
                    <option value="Heroic" <%=isEdit && product.rank==='Heroic' ? 'selected' : '' %>>Heroic</option>
                    <option value="Diamond" <%=isEdit && product.rank==='Diamond' ? 'selected' : '' %>>Diamond</option>
                    <option value="Platinum" <%=isEdit && product.rank==='Platinum' ? 'selected' : '' %>>Platinum</option>
                    <option value="Gold" <%=isEdit && product.rank==='Gold' ? 'selected' : '' %>>Gold</option>
                </select>
            </div>
            <div class="form-group">
                <label for="level">Level *</label>
                <input type="number" id="level" name="level" value="<%= isEdit ? product.level : '' %>" required min="1"
                    max="100" placeholder="e.g., 78">
            </div>
            <div class="form-group" style="flex: 1;">
                <label for="price">Price (₹) *</label>
                <input type="number" id="price" name="price" value="<%= isEdit ? product.price : '' %>" required min="0"
                    step="0.01" placeholder="Original MRP">
                <small style="color: var(--text-dim); font-size: 0.75rem;">Enter the Original MRP of the account.</small>
            </div>
            <div class="form-group" style="flex: 1;">
                <label for="discount">Discount (₹)</label>
                <input type="number" id="discount" name="discount" value="<%= isEdit ? (product.discount || 0) : 0 %>" min="0"
                    placeholder="Amount to subtract">
                <small style="color: var(--text-dim); font-size: 0.75rem;">Amount to be subtracted from Price.</small>
            </div>
            <div class="form-group" style="flex: 1;">
                <label>Final Price (₹)</label>
                <input type="text" id="final_price_preview" readonly 
                    style="background: rgba(0,229,255,0.05); border: 1px dashed var(--primary-neon); color: var(--primary-neon); font-weight: 800; cursor: not-allowed;"
                    value="₹0">
                <small style="color: var(--primary-neon); font-size: 0.75rem;">Auto-calculated Selling Price.</small>
            </div>
        </div>

        <script>
            function updateFinalPrice() {
                const price = parseFloat(document.getElementById('price').value) || 0;
                const discount = parseFloat(document.getElementById('discount').value) || 0;
                const final = Math.max(0, price - discount);
                document.getElementById('final_price_preview').value = '₹' + final.toLocaleString('en-IN');
            }
            document.getElementById('price').addEventListener('input', updateFinalPrice);
            document.getElementById('discount').addEventListener('input', updateFinalPrice);
            // Initial calc
            window.addEventListener('load', updateFinalPrice);
        </script>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" rows="3"
                placeholder="Describe the account features..."><%= isEdit ? (product.description || '') : '' %></textarea>
        </div>

        <div class="form-group">
            <label for="skins">Skins (comma separated)</label>
            <input type="text" id="skins" name="skins"
                value="<%= isEdit && product.skins ? product.skins.join(', ') : '' %>"
                placeholder="e.g., Sakura Bundle, Hip Hop, M1014 Green Flame">
        </div>

        <div class="form-row">
            <div class="form-group" style="flex: 1;">
                <label for="cover_image_input">Cover Image (Main Thumbnail) *</label>
                <input type="file" id="cover_image_input" accept="image/*">
                <input type="hidden" id="cover_image" name="cover_image" value="<%= isEdit ? (product.cover_image || '') : '' %>">
                <small>This image will be shown on the home page cards.</small>
                <div id="coverPreview" class="current-files" style="margin-top: 10px; <%= (isEdit && product.cover_image) ? '' : 'display: none;' %>">
                    <img src="<%= isEdit ? product.cover_image : '' %>" id="coverThumb" alt="" class="preview-thumb" style="width: 120px; height: 120px; object-fit: cover; border-radius: 10px; border: 2px solid var(--primary-neon);">
                </div>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group" style="flex: 1;">
                <label for="images">Detailed Images (Gallery)</label>
                <input type="file" id="images" name="images" multiple accept="image/*">
                <small>Additional images for the collection view.</small>
                <% if (isEdit && product.images && product.images.length > 0) { %>
                    <div class="current-files">
                        <p>Current Gallery Images:</p>
                        <div class="preview-grid">
                        <% product.images.forEach(function(img) { %>
                            <img src="<%= img %>" alt="" class="preview-thumb" style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px; margin-right: 5px;">
                        <% }); %>
                        </div>
                    </div>
                <% } %>
            </div>
            <div class="form-group" style="flex: 1;">
                <label for="videos">Upload Videos</label>
                <input type="file" id="videos" name="videos" multiple accept="video/*">
                <small>Supports: MP4, WebM</small>
                <% if (isEdit && product.videos && product.videos.length > 0) { %>
                    <div class="current-files">
                        <p>Current Videos: <%= product.videos.length %> file(s)</p>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" id="submitBtn" class="btn btn-primary">
                <%= isEdit ? 'Update Product' : 'Create Product' %>
            </button>
            <a href="/admin/products" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<!-- Upload Progress Overlay -->
<div id="uploadOverlay" class="upload-overlay" style="display: none;">
    <div class="upload-card">
        <h3>🚀 Uploading Media...</h3>
        <p>Your files are being sent directly to Cloudinary to bypass server limits.</p>
        <div class="progress-container">
            <div id="progressBar" class="progress-bar" style="width: 0%"></div>
        </div>
        <p id="uploadStatus">Preparing...</p>
    </div>
</div>

<style>
.upload-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0, 10, 20, 0.9);
    backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    z-index: 10000;
}
.upload-card {
    background: #0f172a; border: 1px solid #00f2fe;
    padding: 2.5rem; border-radius: 20px; text-align: center;
    width: 90%; max-width: 450px; color: white;
    box-shadow: 0 0 50px rgba(0, 242, 254, 0.3);
}
.progress-container {
    width: 100%; height: 12px; background: #1e293b;
    border-radius: 6px; margin: 25px 0; overflow: hidden;
}
.progress-bar {
    height: 100%; background: linear-gradient(90deg, #00f2fe, #4facfe);
    transition: width 0.4s cubic-bezier(0.1, 0.7, 0.1, 1);
}
#uploadStatus { font-size: 0.95rem; color: #94a3b8; font-family: 'Rajdhani', sans-serif; }
</style>

<script>
(function() {
    console.log('Premium Upload Script Initialized.');
    const form = document.getElementById('adminProductForm');
    
    if (!form) {
        console.error('Form not found by ID adminProductForm');
        return;
    }

    form.addEventListener('submit', async function(e) {
        const coverInput = document.getElementById('cover_image_input');
        const imagesInput = document.getElementById('images');
        const videosInput = document.getElementById('videos');
        
        const files = [];
        if (coverInput.files && coverInput.files[0]) files.push({f: coverInput.files[0], t: 'image', target: 'cover_image'});
        if (imagesInput.files) Array.from(imagesInput.files).forEach(f => files.push({f, t: 'image', target: 'uploadedImages'}));
        if (videosInput.files) Array.from(videosInput.files).forEach(f => files.push({f, t: 'video', target: 'uploadedVideos'}));
        
        if (files.length === 0) {
            console.log('Proceeding with standard form submission (no new files).');
            return;
        }

        e.preventDefault();
        console.log('Intercepting form submission for direct upload.');
        
        const overlay = document.getElementById('uploadOverlay');
        const progressBar = document.getElementById('progressBar');
        const uploadStatus = document.getElementById('uploadStatus');
        const submitBtn = document.getElementById('submitBtn');

        overlay.style.display = 'flex';
        submitBtn.disabled = true;

        try {
            for (let i = 0; i < files.length; i++) {
                const item = files[i];
                uploadStatus.textContent = `Processing ${item.t} ${i + 1} of ${files.length}...`;
                
                // 1. Get Signed Request from our server
                const signRes = await fetch(`/admin/cloudinary-sign?folder=ff_marketplace/${item.t}s`);
                if (!signRes.ok) throw new Error('Could not get upload credentials from server.');
                const signData = await signRes.json();

                // 2. Upload to Cloudinary API
                const formData = new FormData();
                formData.append('file', item.f);
                formData.append('api_key', signData.apiKey);
                formData.append('timestamp', signData.timestamp);
                formData.append('signature', signData.signature);
                formData.append('folder', signData.folder);

                const response = await fetch(`https://api.cloudinary.com/v1_1/${signData.cloudName}/${item.t}/upload`, {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    const err = await response.json();
                    throw new Error(err.error ? err.error.message : 'Cloudinary Upload Failed');
                }

                const result = await response.json();
                console.log('Upload success:', result.secure_url);

                // 3. Add to form
                if (item.target === 'cover_image') {
                    document.getElementById('cover_image').value = result.secure_url;
                } else {
                    const hiddenInput = document.createElement('input');
                    hiddenInput.type = 'hidden';
                    hiddenInput.name = item.target;
                    hiddenInput.value = result.secure_url;
                    form.appendChild(hiddenInput);
                }

                progressBar.style.width = `${((i + 1) / files.length) * 100}%`;
            }

            // Important: Clear file inputs so Vercel doesn't receive binary data
            const dt = new DataTransfer();
            if (coverInput) coverInput.files = dt.files;
            imagesInput.files = dt.files;
            videosInput.files = dt.files;

            uploadStatus.textContent = 'Finishing preparation...';
            console.log('Submitting final form data.');
            form.submit();

        } catch (error) {
            console.error('Final Upload Error:', error);
            alert('Error: ' + error.message);
            overlay.style.display = 'none';
            submitBtn.disabled = false;
        }
    });
})();
</script>