<style>
    header, footer {
        display: none !important;
    }
    body {
        background-color: #121822 !important; /* Force darker background for auth pages */
    }
    .auth-section {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }
    .marco-card {
        background: #1c232d;
        border-radius: 16px;
        padding: 40px 30px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .marco-logo {
        text-align: center;
        margin-bottom: 30px;
    }
    .marco-logo img {
        height: 70px;
        width: auto;
        max-width: 100%;
        mix-blend-mode: lighten;
    }
    .marco-tabs {
        display: flex;
        background: #131920;
        border-radius: 12px;
        padding: 4px;
        margin-bottom: 25px;
    }
    .marco-tab {
        flex: 1;
        text-align: center;
        padding: 10px 0;
        color: #7a8b9c;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.3s ease;
    }
    .marco-tab.active {
        background: #253347;
        color: #fff;
    }
    .marco-tab:hover:not(.active) {
        color: #fff;
    }
    .marco-google-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #ffffff;
        color: #3c4043;
        width: 100%;
        padding: 10px;
        border-radius: 24px;
        border: 1px solid #dadce0;
        font-family: 'Roboto', 'Inter', sans-serif;
        font-weight: 500;
        font-size: 14px;
        letter-spacing: 0.25px;
        cursor: pointer;
        margin-bottom: 25px;
        text-decoration: none;
        transition: background-color 0.2s, box-shadow 0.2s;
    }
    .marco-google-btn:hover {
        background-color: #f8f9fa;
        box-shadow: 0 1px 2px 0 rgba(60,64,67,0.30), 0 1px 3px 1px rgba(60,64,67,0.15);
    }
    .marco-google-btn img {
        height: 24px;
        width: 24px;
        margin-right: 12px;
    }
    .marco-divider {
        display: flex;
        align-items: center;
        text-align: center;
        color: #4a5c6d;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-bottom: 25px;
    }
    .marco-divider::before,
    .marco-divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #2a3544;
    }
    .marco-divider:not(:empty)::before {
        margin-right: 15px;
    }
    .marco-divider:not(:empty)::after {
        margin-left: 15px;
    }
    .marco-input-group {
        margin-bottom: 20px;
    }
    .marco-label {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #7a8b9c;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 8px;
    }
    .marco-input-wrapper {
        position: relative;
    }
    .marco-input {
        width: 100%;
        background: #161c24;
        border: 1px solid #2a3544;
        color: #fff;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.3s ease;
    }
    .marco-input:focus {
        border-color: #2185ff;
        box-shadow: 0 0 0 2px rgba(33, 133, 255, 0.2);
    }
    .marco-input::placeholder {
        color: #4a5c6d;
    }
    .marco-footer-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }
    .marco-checkbox {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #7a8b9c;
        font-size: 0.85rem;
        cursor: pointer;
    }
    .marco-checkbox input {
        accent-color: #2185ff;
        cursor: pointer;
    }
    .marco-forgot {
        color: #2185ff;
        font-size: 0.85rem;
        text-decoration: none;
        font-weight: 600;
    }
    .marco-forgot:hover {
        text-decoration: underline;
    }
    .marco-submit {
        background: #2185ff;
        color: #fff;
        border: none;
        width: 100%;
        padding: 14px;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: background 0.3s;
    }
    .marco-submit:hover {
        background: #186adc;
    }
</style>

<section class="auth-section">
    <div class="marco-card">
        <div class="marco-logo">
            <a href="/">
                <img src="/images/playnova-logo.png" alt="PlayNova">
            </a>
        </div>

        <div class="marco-tabs">
            <a href="/login" class="marco-tab active">Sign In</a>
            <a href="/register" class="marco-tab">Sign Up</a>
        </div>

        <a href="/auth/google" class="marco-google-btn">
            <img src="/images/google-3d.png" alt="G">
            Sign in with Google
        </a>

        <div class="marco-divider">OR CONTINUE WITH EMAIL</div>

        <form action="/login" method="POST">
            <div class="marco-input-group">
                <label class="marco-label" for="email">
                    <i class="fa-regular fa-envelope"></i> Email
                </label>
                <div class="marco-input-wrapper">
                    <input type="email" id="email" name="email" class="marco-input" placeholder="your@gmail.com" required>
                </div>
            </div>

            <div class="marco-input-group">
                <label class="marco-label" for="password">
                    <i class="fa-solid fa-lock"></i> Password
                </label>
                <div class="marco-input-wrapper">
                    <input type="password" id="password" name="password" class="marco-input" placeholder="Enter your password" required>
                </div>
            </div>

            <div class="marco-footer-row">
                <label class="marco-checkbox">
                    <input type="checkbox" name="remember"> Remember me
                </label>
                <a href="#" class="marco-forgot" onclick="alert('Password reset coming soon!')">Forgot Password?</a>
            </div>

            <button type="submit" class="marco-submit">
                <i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In
            </button>
        </form>
    </div>
</section>