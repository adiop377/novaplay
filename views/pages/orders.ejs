<section class="orders-section container section">
    <h2 class="section-title">My <span class="neon-text-green">Orders</span></h2>

    <% if (orders && orders.length> 0) { %>
        <div class="orders-list">
            <% orders.forEach(function(order) { %>
                <div class="order-card">
                    <div class="order-header">
                        <div class="order-id">
                            <span class="label">Order</span>
                            <span class="value">#<%= order.id %></span>
                        </div>
                        <div class="order-date">
                            <%= new Date(order.created_at).toLocaleDateString('en-IN', { day: '2-digit' , month: 'short'
                                , year: 'numeric' }) %>
                        </div>
                        <div class="order-status status-<%= order.status %>">
                            <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                        </div>
                    </div>
                    <div class="order-items">
                        <% if (order.items && order.items.length> 0) { %>
                            <% order.items.forEach(function(item) { %>
                                <div class="order-item">
                                    <span class="item-title">
                                        <%= item.title %>
                                    </span>
                                    <span class="item-price">₹<%= parseFloat(item.price).toLocaleString('en-IN') %>
                                            </span>
                                </div>
                                <% }); %>
                                    <% } %>
                    </div>
                    <div class="order-footer">
                        <div class="order-total">
                            Total: <strong>₹<%= parseFloat(order.total).toLocaleString('en-IN') %></strong>
                        </div>
                        <div class="payment-status payment-<%= order.payment_status %>">
                            Payment: <%= order.payment_status.charAt(0).toUpperCase() + order.payment_status.slice(1) %>
                        </div>
                    </div>
                </div>
                <% }); %>
        </div>
        <% } else { %>
            <div class="empty-orders">
                <div class="empty-icon">📦</div>
                <h3>No orders yet</h3>
                <p>Start shopping to see your orders here!</p>
                <a href="/" class="btn btn-primary">Browse Products</a>
            </div>
            <% } %>
</section>