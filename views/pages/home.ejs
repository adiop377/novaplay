<!-- Hero Section -->
<section id="home" class="hero" style="min-height: 90vh; display: flex; align-items: center; justify-content: center; position: relative; padding-top: 100px;">
    <!-- Advanced Badass Background Animations -->
    <div class="hero-bg-animations" id="parallax-bg" style="transition: transform 0.1s cubic-bezier(0.2, 0.8, 0.2, 1); will-change: transform;">

        <div class="glow-orb orb-1"></div>
        <div class="glow-orb orb-2"></div>
        <div class="glow-orb orb-3"></div>
