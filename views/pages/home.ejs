    <div class="discount-badge" style="position: absolute; top: 120px; right: 5%; background: linear-gradient(135deg, #ff0055, #ff4444); color: white; padding: 10px 20px; border-radius: 50px; font-weight: 800; font-size: 0.85rem; letter-spacing: 1px; box-shadow: 0 0 20px rgba(255, 0, 85, 0.4); border: 1px solid rgba(255,255,255,0.2); animation: pulse 2s infinite;">🔥 SAVE 20% TODAY</div>
    
    <div class="container hero-content" style="position: relative; z-index: 1; text-align: center; max-width: 900px; margin: 0 auto;">
        
        <!-- Hero Badge Redesigned per User Screenshot -->
        <div class="hero-badge fade-up" style="display: flex; justify-content: center; align-items: center; gap: 12px; padding: 4px 18px 4px 4px; border: 1px solid rgba(0, 229, 255, 0.4); border-radius: 50px; background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(12px); box-shadow: 0 4px 20px rgba(0,0,0,0.5); width: fit-content; margin: 0 auto 25px auto;">
            <!-- Inner Capsule containing PlayNova Skull + Free Fire Text -->
            <div style="display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.1); padding: 5px 12px 5px 5px; border-radius: 50px; border: 1px solid rgba(255,255,255,0.1);">
                <img src="/images/playnova-logo.png" alt="PlayNova Logo" style="height: 24px; width: 24px; object-fit: cover; border-radius: 50%; margin-right: 8px;">
                <img src="https://upload.wikimedia.org/wikipedia/en/3/38/Free_Fire_New_Logo.svg" alt="Free Fire" style="height: 14px; width: auto; object-fit: contain; filter: brightness(0) invert(1);">
            </div>
            <!-- Secondary Text -->
            <span style="font-family: 'Rajdhani', sans-serif; font-weight: 700; font-size: 0.85rem; letter-spacing: 1.5px; color: #ffffff; text-transform: uppercase;">
                Verified <span style="color: #00e5ff;">Accounts</span>
            </span>
        </div>
        
        <!-- Elegant + Heavy Glow Headline per Screenshot -->
        <h1 class="fade-up" style="margin-bottom: 25px; text-transform: uppercase; display: flex; flex-direction: column; align-items: center; gap: 5px;">
            <span style="font-family: 'Georgia', 'Playfair Display', serif; font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 900; color: #ffffff; text-shadow: 0 4px 10px rgba(0,0,0,0.5); letter-spacing: 1px; line-height: 1;">BUY VERIFIED</span> 
            <span style="font-family: 'Orbitron', sans-serif; font-size: clamp(3rem, 7vw, 5.8rem); font-weight: 900; letter-spacing: -1px; line-height: 1; background: linear-gradient(to bottom, #00e5ff 0%, #2979ff 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 0 25px rgba(0, 229, 255, 0.7)) drop-shadow(0 0 40px rgba(0, 229, 255, 0.3));">FREE FIRE IDS</span>
        </h1>
        
        <p class="fade-up delay-1" style="font-size: 1.25rem; color: #b3b3b3; letter-spacing: 1px; font-weight: 500; margin-bottom: 40px; max-width: 600px; margin-left: auto; margin-right: auto; line-height: 1.6;">
            The most trusted destination for acquiring high-end gaming accounts with instant credential delivery.
        </p>
        
        <div class="hero-btns fade-up delay-2" style="display: flex; justify-content: center; gap: 20px; margin-bottom: 40px;">
            <a href="#ids" class="btn btn-primary" style="padding: 16px 45px; font-size: 1.1rem; border-radius: 50px;">Browse Shop</a>
            <a href="https://t.me/premiumffzone" class="btn btn-secondary" style="padding: 16px 45px; font-size: 1.1rem; border-radius: 50px;">Sell Your Account</a>
        </div>
        
        <div class="trust-badges fade-up delay-2" style="display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 30px; padding: 18px 40px; background: rgba(0, 229, 255, 0.03); border: 1px solid rgba(0, 229, 255, 0.1); border-radius: 100px; font-size: 0.9rem; color: #ffffff; backdrop-filter: blur(15px); box-shadow: inset 0 0 20px rgba(0, 229, 255, 0.05);">
            <span style="display: flex; align-items: center; gap: 10px; font-weight: 500; letter-spacing: 0.5px;">
                <div style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: rgba(0, 229, 255, 0.1); border-radius: 50%; color: #00e5ff; box-shadow: 0 0 10px rgba(0, 229, 255, 0.2);">
                    <i class="fas fa-shield-halved"></i>
                </div>
                Secure Payment
            </span>
            <span style="color: rgba(0, 229, 255, 0.2); font-weight: 200;">|</span>
            <span style="display: flex; align-items: center; gap: 10px; font-weight: 500; letter-spacing: 0.5px;">
                <div style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: rgba(0, 255, 127, 0.1); border-radius: 50%; color: #00ff7f; box-shadow: 0 0 10px rgba(0, 255, 127, 0.2);">
                    <i class="fas fa-check-double"></i>
                </div>
                Verified Accounts
            </span>
            <span style="color: rgba(0, 229, 255, 0.2); font-weight: 200;">|</span>
            <span style="display: flex; align-items: center; gap: 10px; font-weight: 500; letter-spacing: 0.5px;">
                <div style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: rgba(255, 170, 0, 0.1); border-radius: 50%; color: #ffaa00; box-shadow: 0 0 10px rgba(255, 170, 0, 0.2);">
                    <i class="fas fa-bolt-lightning"></i>
                </div>
                Instant Transfer
            </span>
        </div>

        <!-- BROWSING CTA -->
        <div class="hero-btns fade-up delay-2" style="display: flex; flex-direction: column; align-items: center; gap: 25px; margin-top: 80px; width: 100%;">
            <p style="color: var(--primary-neon); font-family: 'Orbitron', sans-serif; font-size: 1.4rem; letter-spacing: 2px; font-weight: 800; margin: 0;">Need Diamonds?</p>
            <a href="/topup" class="btn" style="padding: 16px 60px; font-size: 1.1rem; border-radius: 50px; border: 2px solid #00e5ff; background: rgba(0, 229, 255, 0.05); color: #00e5ff; font-weight: 800; text-transform: uppercase; box-shadow: 0 5px 15px rgba(0, 229, 255, 0.1);">Diamond Topup</a>
        </div>
    </div>
</section>

<!-- Top Selling IDs Section -->
<section class="container section">
    <div class="section-header">
        <h2 class="section-title">Top Selling <span class="neon-text-green">IDs</span></h2>
        <p style="text-align: center; color: var(--text-dim); margin-top: -40px; margin-bottom: 50px;">
            Highly demanded accounts flying off the shelves
        </p>
    </div>
    <div class="id-grid">
        <% if (products && products.length > 0) { %>
            <% products.slice(0, 4).forEach(function(product) { %>
                <%- include('../partials/product-card', { product: product }) %>
            <% }); %>
        <% } else { %>
            <p style="text-align: center; width: 100%; color: var(--text-dim);">No top selling IDs right now.</p>
        <% } %>
    </div>
</section>



<!-- Products Section -->
<section id="ids" class="container section">
    <div class="section-header">
        <h2 class="section-title">Featured <span class="neon-text-green">Top Deals</span></h2>
        <p style="text-align: center; color: var(--text-dim); margin-top: -40px; margin-bottom: 50px;">
            Handpicked premium accounts with rarest bundles
        </p>
    </div>

    <div class="shop-container">
        <aside class="shop-filters">
            <form id="filterForm" method="GET" action="/">
                <div class="filter-group">
                    <label>Search account</label>
                    <div class="search-box">
                        <input type="text" name="search" id="searchInput" placeholder="Search by title or rank..."
                            value="<%= filters.search %>">
                    </div>
                </div>
                <div class="filter-group">
                    <label>Rank Filter</label>
                    <select name="rank" id="rankFilter">
                        <option value="all" <%=filters.rank==='all' ? 'selected' : '' %>>All Ranks</option>
                        <option value="Grandmaster" <%=filters.rank==='Grandmaster' ? 'selected' : '' %>>Grandmaster
                        </option>
                        <option value="Master" <%=filters.rank==='Master' ? 'selected' : '' %>>Master</option>
                        <option value="Heroic" <%=filters.rank==='Heroic' ? 'selected' : '' %>>Heroic</option>
                        <option value="Diamond" <%=filters.rank==='Diamond' ? 'selected' : '' %>>Diamond</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Max Price: <span id="priceValue">₹<%= filters.maxPrice ? parseInt(filters.maxPrice).toLocaleString('en-IN') : '2,00,000' %></span></label>
                    <input type="range" name="maxPrice" id="priceFilter" min="0" max="200000" step="500"
                        value="<%= filters.maxPrice || 200000 %>">
                </div>
                <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
                <a href="/" class="btn btn-secondary w-100" style="margin-top: 10px;">Reset Filters</a>
            </form>
        </aside>

        <div class="id-grid">
            <% if (products && products.length> 0) { %>
                <% products.forEach(function(product) { %>
                    <%- include('../partials/product-card', { product: product }) %>
                        <% }); %>
                            <% } else { %>
                                <div style="grid-column: 1/-1; text-align: center; padding: 100px 20px;">
                                    <div style="font-size: 3rem; margin-bottom: 20px;">🔍</div>
                                    <h3>No items match your filters</h3>
                                    <p style="color: var(--text-dim)">Try adjusting your search criteria or price range.
                                    </p>
                                </div>
                                <% } %>
        </div>
    </div>
</section>

