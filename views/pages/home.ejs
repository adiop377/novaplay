<!-- Background Interactive Parallax Script -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const hero = document.getElementById('home');
        const parallaxBg = document.getElementById('parallax-bg');
        
        if (hero && parallaxBg) {
            hero.addEventListener('mousemove', (e) => {
                // Positively tied to mouse position directly = moves toward cursor
                const xAxis = (e.pageX - window.innerWidth / 2) / 25;
                const yAxis = (e.pageY - window.innerHeight / 2) / 25;
                
                parallaxBg.style.transform = `translate(${xAxis}px, ${yAxis}px)`;
            });
            
            hero.addEventListener('mouseleave', () => {
                parallaxBg.style.transform = `translate(0px, 0px)`;
            });
        }
    });
</script>