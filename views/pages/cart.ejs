<section class="cart-section container section">
    <h2 class="section-title">Shopping <span class="neon-text-green">Cart</span></h2>

    <% if (cartItems && cartItems.length> 0) { %>
        <div class="cart-container">
            <div class="cart-items-list">
                <% cartItems.forEach(function(item) { %>
                    <div class="cart-item-card">
                        <% if (item.images && item.images.length> 0) { %>
                            <img src="<%= item.images[0] %>" alt="<%= item.title %>">
                            <% } else { %>
                                <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&q=80&w=200"
                                    alt="<%= item.title %>">
                                <% } %>
                                    <div class="cart-item-info">
                                        <h4>
                                            <%= item.title %>
                                        </h4>
                                        <p><span class="rank-badge">
                                                <%= item.rank %>
                                            </span> Level <%= item.level %>
                                        </p>
                                        <% if (item.tag) { %>
                                            <span class="tag-badge">
                                                <%= item.tag %>
                                            </span>
                                            <% } %>
                                    </div>
                                    <div class="cart-item-price">
                                        ₹<%= item.price.toLocaleString('en-IN') %>
                                    </div>
                                    <a href="/cart/remove/<%= item.product_id %>" class="remove-btn"
                                        title="Remove">✕</a>
                    </div>
                    <% }); %>
            </div>

            <div class="cart-summary">
                <h3>Order Summary</h3>
                <div class="summary-row">
                    <span>Items (<%= cartItems.length %>)</span>
                    <span id="cartSubtotal">₹<%= total.toLocaleString('en-IN') %></span>
                </div>

                <!-- Nova Coins Discount Widget -->
                <% const userCoins = (user && user.nova_coins !== undefined) ? (user.nova_coins || 0) : 0; %>
                <% const maxCoinsDeduct = Math.min(userCoins, Math.max(0, total - 1)); %>
                
                <div class="cart-coins-discount-card">
                    <div class="cart-coins-header">
                        <label class="custom-coin-toggle">
                            <input type="checkbox" id="chkUseNovaCoins" onchange="toggleCartCoins()">
                            <span class="coin-toggle-slider"></span>
                            <span class="coin-toggle-text">
                                <strong>Redeem Nova Coins</strong>
                                <small>Available: 🪙 <%= userCoins %> Coins</small>
                            </span>
                        </label>
                    </div>
                    <div class="cart-coins-row" id="cartCoinsDiscountRow" style="display: none;">
                        <span>Nova Coins Discount (<%= maxCoinsDeduct %> Coins):</span>
                        <span class="text-green">-₹<%= maxCoinsDeduct.toLocaleString('en-IN') %></span>
                    </div>
                </div>

                <!-- Nova Coins Cashback Return Banner -->
                <div class="cart-cashback-badge">
                    <span class="cashback-coin-anim">🪙</span>
                    <div>
                        <strong>+125 Nova Coins Cashback</strong>
                        <span>Purchase complete hone par aapko 125 Nova Coins return milenge!</span>
                    </div>
                </div>

                <div class="summary-row total">
                    <span>Total</span>
                    <span class="total-price" id="cartFinalTotal">₹<%= total.toLocaleString('en-IN') %></span>
                </div>
                
                <a href="/orders/checkout" id="btnCartCheckout" class="btn btn-primary w-100">Proceed to Checkout</a>
                <a href="/cart/clear" class="btn btn-secondary w-100" style="margin-top: 10px;">Clear Cart</a>
            </div>
        </div>

        <script>
            const originalTotal = <%= total %>;
            const maxCoins = <%= maxCoinsDeduct %>;

            function toggleCartCoins() {
                const chk = document.getElementById('chkUseNovaCoins');
                const row = document.getElementById('cartCoinsDiscountRow');
                const totalEl = document.getElementById('cartFinalTotal');
                const btn = document.getElementById('btnCartCheckout');

                if (chk && chk.checked && maxCoins > 0) {
                    if (row) row.style.display = 'flex';
                    const newTotal = Math.max(1, originalTotal - maxCoins);
                    if (totalEl) totalEl.innerText = '₹' + newTotal.toLocaleString('en-IN');
                    if (btn) btn.href = '/orders/checkout?use_coins=1';
                } else {
                    if (row) row.style.display = 'none';
                    if (totalEl) totalEl.innerText = '₹' + originalTotal.toLocaleString('en-IN');
                    if (btn) btn.href = '/orders/checkout';
                }
            }
        </script>
        <% } else { %>
            <div class="empty-cart">
                <div class="empty-icon">🛒</div>
                <h3>Your cart is empty</h3>
                <p>Browse our collection and add some awesome IDs!</p>
                <a href="/" class="btn btn-primary">Browse Products</a>
            </div>
            <% } %>
</section>