<section class="cart-section container section">
    <h2 class="section-title">Shopping <span class="neon-text-green">Cart</span></h2>

    <% if (cartItems && cartItems.length> 0) { %>
        <div class="cart-container">
            <div class="cart-items-list">
                <% cartItems.forEach(function(item) { %>
                    <div class="cart-item-card">
                        <% if (item.images && item.images.length> 0) { %>
                            <img src="<%= item.images[0] %>" alt="<%= item.title %>">
                            <% } else { %>
                                <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&q=80&w=200"
                                    alt="<%= item.title %>">
                                <% } %>
                                    <div class="cart-item-info">
                                        <h4>
                                            <%= item.title %>
                                        </h4>
                                        <p><span class="rank-badge">
                                                <%= item.rank %>
                                            </span> Level <%= item.level %>
                                        </p>
                                        <% if (item.tag) { %>
                                            <span class="tag-badge">
                                                <%= item.tag %>
                                            </span>
                                            <% } %>
                                    </div>
                                    <div class="cart-item-price">
                                        ₹<%= item.price.toLocaleString('en-IN') %>
                                    </div>
                                    <a href="/cart/remove/<%= item.product_id %>" class="remove-btn"
                                        title="Remove">✕</a>
                    </div>
                    <% }); %>
            </div>

            <div class="cart-summary">
                <h3>Order Summary</h3>
                <div class="summary-row">
                    <span>Items (<%= cartItems.length %>)</span>
                    <span>₹<%= total.toLocaleString('en-IN') %></span>
                </div>
                <div class="summary-row total">
                    <span>Total</span>
                    <span class="total-price">₹<%= total.toLocaleString('en-IN') %></span>
                </div>
                <a href="/orders/checkout" class="btn btn-primary w-100">Proceed to Checkout</a>
                <a href="/cart/clear" class="btn btn-secondary w-100" style="margin-top: 10px;">Clear Cart</a>
            </div>
        </div>
        <% } else { %>
            <div class="empty-cart">
                <div class="empty-icon">🛒</div>
                <h3>Your cart is empty</h3>
                <p>Browse our collection and add some awesome IDs!</p>
                <a href="/" class="btn btn-primary">Browse Products</a>
            </div>
            <% } %>
</section>