<section class="container" style="padding-top: 120px; padding-bottom: 50px;">
    <a href="/" class="btn" style="margin-bottom: 20px; display: inline-block; color: var(--text-dim); text-decoration: none;">&larr; Back to Shop</a>
    
    <div class="product-details-container" style="display: flex; gap: 40px; margin-top: 20px; flex-wrap: wrap;">
        <!-- Images -->
        <div class="product-images" style="flex: 1; min-width: 300px; display: flex; flex-direction: column; gap: 20px;">
            <% if (product.images && product.images.length > 0) { %>
                <% product.images.forEach(function(media, index) { %>
                    <% if (media.match(/\.(mp4|webm|ogg)$/i)) { %>
                        <video controls style="width: 100%; border-radius: 20px; border: 1px solid var(--glass-border); box-shadow: 0 5px 15px rgba(0,0,0,0.2);">
                            <source src="<%= media %>">
                            Your browser does not support videos.
                        </video>
                    <% } else { %>
                        <img src="<%= media %>" alt="<%= product.title %> media <%= index+1 %>" onclick="openLightbox(this.src)" style="width: 100%; border-radius: 20px; border: 1px solid var(--glass-border); box-shadow: 0 5px 15px rgba(0,0,0,0.2); cursor: pointer; transition: 0.3s;" onmouseover="this.style.transform='scale(1.02)'; this.style.borderColor='var(--primary-neon)';" onmouseout="this.style.transform='scale(1)'; this.style.borderColor='var(--glass-border)';">
                    <% } %>
                <% }); %>
            <% } else { %>
                <img src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&q=80&w=400" alt="<%= product.title %>" onclick="openLightbox(this.src)" style="width: 100%; border-radius: 20px; border: 1px solid var(--glass-border); box-shadow: 0 5px 15px rgba(0,0,0,0.2); cursor: pointer; transition: 0.3s;" onmouseover="this.style.transform='scale(1.02)'; this.style.borderColor='var(--primary-neon)';" onmouseout="this.style.transform='scale(1)'; this.style.borderColor='var(--glass-border)';">
            <% } %>
        </div>
        
        <!-- Details -->
        <div class="product-info" style="flex: 1; min-width: 300px; background: var(--card-bg); padding: 40px; border-radius: 20px; border: 1px solid var(--glass-border); backdrop-filter: blur(10px); height: fit-content; position: sticky; top: 100px;">
            <% if (product.tag) { %>
                <span class="id-tag" style="background: var(--accent-red); padding: 5px 10px; border-radius: 5px; font-weight: bold; font-size: 0.8rem; display: inline-block; margin-bottom: 15px;"><%= product.tag %></span>
            <% } %>
            
            <h1 style="font-size: 2.5rem; margin-bottom: 20px; color: #fff;"><%= product.title %></h1>
            
            <div class="stats" style="display: flex; gap: 20px; margin-bottom: 30px; font-size: 1.2rem; color: var(--text-dim);">
                <span><i class="icon">🏆</i> Rank: <%= product.rank %></span>
                <span><i class="icon">🔥</i> Level: <%= product.level %></span>
            </div>
            
            <% if (product.description) { %>
                <div style="margin-bottom: 30px;">
                    <h3 style="margin-bottom: 10px; color: var(--primary-neon);">Description</h3>
                    <p style="line-height: 1.6; color: var(--text-dim);"><%= product.description %></p>
                </div>
            <% } %>

            <div style="margin-bottom: 40px;">
                <h3 style="margin-bottom: 15px; color: var(--secondary-neon);">Rare Items / Skins</h3>
                <div class="rare-skins" style="display: flex; flex-wrap: wrap; gap: 10px;">
                    <% if (product.skins && product.skins.length > 0) { %>
                        <% product.skins.forEach(function(skin) { %>
                            <span class="skin-tag" style="background: rgba(160, 32, 240, 0.1); color: var(--secondary-neon); padding: 8px 15px; border-radius: 5px; border: 1px solid rgba(160, 32, 240, 0.2); font-weight: bold;">
                                <%= skin %>
                            </span>
                        <% }); %>
                    <% } else { %>
                        <span style="color: var(--text-dim);">No special items listed.</span>
                    <% } %>
                </div>
            </div>
            
            <div class="price-action-row" style="border-top: 1px solid var(--glass-border); padding-top: 30px;">
                <div class="price-container" style="margin-bottom: 25px;">
                    <% if (product.discount > 0) { 
                        let finalPrice = parseFloat(product.price) - parseFloat(product.discount);
                    %>
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 5px;">
                             <span style="text-decoration: line-through; color: rgba(255,255,255,0.3); font-size: 1.2rem; font-weight: 600;">₹<%= parseFloat(product.price).toLocaleString('en-IN') %></span>
                             <span style="background: rgba(255, 68, 68, 0.1); color: #ff4444; padding: 4px 12px; border-radius: 50px; font-weight: 800; font-size: 0.85rem; border: 1px solid rgba(255, 68, 68, 0.2); text-transform: uppercase;">
                                SAVE ₹<%= parseFloat(product.discount).toLocaleString('en-IN') %>
                             </span>
                        </div>
                        <h2 style="font-size: 3.5rem; color: #fff; font-weight: 900; background: linear-gradient(135deg, #00e5ff, #fff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; line-height: 1.1; margin-bottom: 10px;">
                            ₹<%= finalPrice.toLocaleString('en-IN') %>
                        </h2>
                    <% } else { %>
                        <h2 style="font-size: 3.5rem; color: #fff; font-weight: 900; background: linear-gradient(135deg, #00e5ff, #fff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; line-height: 1.1; margin-bottom: 10px;">
                            ₹<%= parseFloat(product.price).toLocaleString('en-IN') %>
                        </h2>
                    <% } %>
                </div>
                
                <div style="display: flex; gap: 20px;">
                    <a href="/cart/add/<%= product.id %>" class="btn btn-primary" style="flex: 1; text-align: center; font-size: 1.2rem; padding: 15px; display: flex; align-items: center; justify-content: center; text-decoration: none; border-radius: 12px; font-weight: 800; box-shadow: 0 10px 20px rgba(0, 229, 255, 0.2);">BUY NOW</a>
                    <button class="btn btn-secondary" onclick="addToCart(<%= product.id %>)" style="padding: 15px 25px; font-size: 1.5rem; border: 1px solid var(--glass-border); background: rgba(255,255,255,0.05); color: white; border-radius: 12px; cursor: pointer; transition: 0.3s; display: flex; align-items: center; justify-content: center;" onmouseover="this.style.background='rgba(255,255,255,0.1)'; this.style.borderColor='rgba(255,255,255,0.2)';" onmouseout="this.style.background='rgba(255,255,255,0.05)'; this.style.borderColor='var(--glass-border)';">🛒</button>
                </div>
            </div>
        </div>
    </div>
    </div>
</section>

<!-- Lightbox Modal -->
<div id="imageLightbox" style="display: none; position: fixed; z-index: 10000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(5,6,8,0.95); backdrop-filter: blur(8px); opacity: 0; transition: opacity 0.3s ease; overflow: auto;">
    <span onclick="closeLightbox()" style="position: fixed; top: 20px; right: 30px; color: #fff; font-size: 40px; font-weight: bold; cursor: pointer; transition: color 0.3s; z-index: 10001;" onmouseover="this.style.color='var(--primary-neon)'" onmouseout="this.style.color='#fff'">&times;</span>
    <div id="lightboxContent" style="width: 100%; min-height: 100%; display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
        <img id="lightboxImage" onclick="toggleZoom(event)" style="cursor: zoom-in; max-width: 100%; max-height: 90vh; border-radius: 10px; box-shadow: 0 0 30px rgba(0, 255, 136, 0.2); transform: scale(0.95); transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);">
    </div>
</div>

<script>
    let isZoomed = false;

    function openLightbox(src) {
        const lightbox = document.getElementById('imageLightbox');
        const img = document.getElementById('lightboxImage');
        const content = document.getElementById('lightboxContent');
        
        img.src = src;
        
        // Reset state
        isZoomed = false;
        img.style.maxHeight = '90vh';
        img.style.maxWidth = '100%';
        img.style.cursor = 'zoom-in';
        content.style.alignItems = 'center';
        
        lightbox.style.display = 'block';
        
        // Trigger animation
        setTimeout(() => {
            lightbox.style.opacity = '1';
            img.style.transform = 'scale(1)';
        }, 10);
        document.body.style.overflow = 'hidden';
    }
    
    function closeLightbox() {
        const lightbox = document.getElementById('imageLightbox');
        const img = document.getElementById('lightboxImage');
        lightbox.style.opacity = '0';
        img.style.transform = 'scale(0.95)';
        setTimeout(() => {
            lightbox.style.display = 'none';
            document.body.style.overflow = 'auto';
        }, 300);
    }

    function toggleZoom(e) {
        e.stopPropagation();
        const img = document.getElementById('lightboxImage');
        const content = document.getElementById('lightboxContent');
        
        isZoomed = !isZoomed;
        
        if (isZoomed) {
            img.style.maxHeight = 'none';
            img.style.maxWidth = 'none';
            img.style.cursor = 'zoom-out';
            content.style.alignItems = 'flex-start';
        } else {
            img.style.maxHeight = '90vh';
            img.style.maxWidth = '100%';
            img.style.cursor = 'zoom-in';
            content.style.alignItems = 'center';
        }
    }

    // Close on click outside
    document.getElementById('lightboxContent').addEventListener('click', function(e) {
        if(e.target === this) {
            closeLightbox();
        }
    });

    // Close on escape key
    document.addEventListener('keydown', function(e) {
        if(e.key === 'Escape' && document.getElementById('imageLightbox').style.display === 'block') {
            closeLightbox();
        }
    });
</script>
