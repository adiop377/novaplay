<!-- views/pages/checkout-payment.ejs -->
<section class="checkout-section container section" style="padding-top: 130px;">
    <h2 class="section-title">Complete <span class="neon-text-green">Payment</span></h2>

    <div class="checkout-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px;">
        <!-- Order Summary -->
        <div class="order-summary card-theme" style="background: var(--card-bg); padding: 30px; border-radius: 20px; border: 1px solid var(--glass-border);">
            <h3 style="margin-bottom: 20px; color: var(--primary-neon);">Order Summary (Order #<%= order.id %>)</h3>
            
            <% 
               const hasCoinDiscount = order.items && order.items.some(it => it.title && it.title.includes('Nova Coins Discount'));
               const userCoins = (user && user.nova_coins !== undefined) ? (user.nova_coins || 0) : 0;
            %>

            <% if (!hasCoinDiscount && userCoins > 0 && parseFloat(order.total) > 1) { %>
                <div id="checkoutRedeemCard" style="background: rgba(0, 255, 102, 0.08); border: 1px dashed rgba(0, 255, 102, 0.4); border-radius: 12px; padding: 14px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span style="font-size: 1.6rem;">🪙</span>
                        <div>
                            <strong style="color: #fff; font-size: 0.95rem; display: block;">Redeem Nova Coins</strong>
                            <small style="color: #94a3b8;">Balance: 🪙 <%= userCoins %> Coins (Save ₹<%= Math.min(userCoins, Math.floor(parseFloat(order.total) - 1)) %>)</small>
                        </div>
                    </div>
                    <button type="button" onclick="applyCoinsToOrder(<%= order.id %>)" class="btn btn-sm" style="background: #00ff66; color: #000; font-weight: 800; border: none; padding: 8px 16px; border-radius: 8px; cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                        Apply Discount ⚡
                    </button>
                </div>
            <% } else if (hasCoinDiscount) { %>
                <div style="background: rgba(0, 255, 102, 0.12); border: 1px solid rgba(0, 255, 102, 0.5); border-radius: 12px; padding: 12px 16px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 1.4rem;">🪙</span>
                    <span style="color: #00ff66; font-weight: 700; font-size: 0.95rem;">Nova Coins Discount Active! Saved from total.</span>
                </div>
            <% } %>

            <div class="checkout-items" style="margin-bottom: 20px;">
                <% order.items.forEach(function(item) { %>
                    <% const priceNum = parseFloat(item.price); %>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 15px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 15px;">
                        <span style="font-weight: 500; <%= priceNum < 0 ? 'color: #00ff66;' : '' %>"><%= item.title %></span>
                        <strong style="color: <%= priceNum < 0 ? '#00ff66' : 'var(--primary-neon)' %>;">
                            <%= priceNum < 0 ? `-₹${Math.abs(priceNum).toLocaleString('en-IN')}` : `₹${priceNum.toLocaleString('en-IN')}` %>
                        </strong>
                    </div>
                <% }); %>
            </div>
            
            <div class="total-row" style="display: flex; justify-content: space-between; font-size: 1.5rem; font-weight: bold; margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 15px;">
                <span>Total Amount:</span>
                <span style="color: #00ff66; text-shadow: 0 0 12px rgba(0,255,102,0.6);">₹<%= parseFloat(order.total).toLocaleString('en-IN') %></span>
            </div>

            <!-- Nova Coins Cashback Callout -->
            <div style="margin-top: 20px; background: linear-gradient(135deg, rgba(255, 184, 0, 0.12), rgba(0, 255, 102, 0.08)); border: 1px solid rgba(255, 184, 0, 0.4); border-radius: 12px; padding: 14px; display: flex; align-items: center; gap: 12px;">
                <span style="font-size: 1.8rem; filter: drop-shadow(0 0 8px rgba(255, 184, 0, 0.6));">🪙</span>
                <div>
                    <strong style="color: #ffd700; font-size: 0.95rem; display: block; font-family: 'Rajdhani', sans-serif; letter-spacing: 0.5px;">+125 NOVA COINS CASHBACK</strong>
                    <span style="color: #cbd5e1; font-size: 0.8rem;">Upon payment confirmation, <strong>125 Nova Coins</strong> will be credited directly to your wallet!</span>
                </div>
            </div>
        </div>

        <!-- Payment Actions -->
        <div class="payment-actions card-theme" style="background: var(--card-bg); padding: 30px; border-radius: 20px; border: 1px solid var(--glass-border);">
            <h3 style="margin-bottom: 20px;">Billing Details & Payment</h3>

            <div class="form-group" style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; color: var(--text-dim);">Full Name</label>
                <input type="text" id="custName" value="<%= order.user_name %>" class="form-input" style="width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: #fff; border-radius: 8px;">
            </div>

            <div class="form-group" style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; color: var(--text-dim);">Email Address</label>
                <input type="email" id="custEmail" value="<%= order.user_email %>" class="form-input" style="width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: #fff; border-radius: 8px;">
            </div>

            <div class="form-group" style="margin-bottom: 30px;">
                <label style="display: block; margin-bottom: 5px; color: var(--text-dim);">Telegram/WhatsApp Number</label>
                <input type="tel" id="custPhone" placeholder="Enter Telegram or WhatsApp Number" class="form-input" style="width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: #fff; border-radius: 8px;">
            </div>
            
            <!-- Manual UPI Section (Shown by default) -->
            <div id="manual-upi-section" style="display: block; margin-top: 10px; text-align: center; border-top: 1px solid var(--glass-border); padding-top: 20px;">
                <h4 style="margin-bottom: 10px; font-size: 1.1rem; color: var(--text-main);">Scan to Pay via Any UPI App</h4>
                
                <div style="background: rgba(0, 229, 255, 0.08); border: 1px solid rgba(0, 229, 255, 0.3); border-radius: 10px; padding: 10px; margin-bottom: 15px; display: inline-block; min-width: 250px;">
                    <div style="font-size: 0.85rem; color: #94a3b8;">Payable Amount:</div>
                    <div style="font-size: 1.8rem; font-weight: 900; color: #00e5ff; font-family: 'Orbitron', monospace;">₹<%= parseFloat(order.total).toLocaleString('en-IN') %></div>
                </div>

                <div style="background: transparent; display: block; margin-bottom: 15px;">
                    <img src="/images/upi-qr.jpg" alt="UPI QR Code" style="width: 250px; border-radius: 15px; box-shadow: 0 0 20px rgba(0, 229, 255, 0.2); border: 2px solid var(--primary-neon);">
                </div>
                <p style="font-size: 0.9rem; color: var(--text-dim); margin-bottom: 15px;">After payment, send your screenshot to the admin on Telegram.</p>
                
                <a href="https://t.me/premiumffzone" 
                   target="_blank" class="btn-primary" style="display: block; width: 100%; text-decoration: none; margin-bottom: 10px; background: #0088cc; border: none; font-size: 1.05rem; padding: 12px;">
                    Send Screenshot to Admin ✅
                </a>
                
                <a href="/orders" class="btn-secondary" style="display: block; width: 100%; text-decoration: none; border: 1px solid var(--glass-border);">Go to My Orders 🛒</a>
            </div>
        </div>
    </div>
</section>

<!-- Mobile responsiveness -->
<style>
    @media (max-width: 768px) {
        .checkout-grid {
            grid-template-columns: 1fr !important;
        }
    }
</style>

<script>
async function applyCoinsToOrder(orderId) {
    try {
        Swal.fire({
            title: 'Applying Nova Coins...',
            text: 'Deducting discount...',
            allowOutsideClick: false,
            showConfirmButton: false,
            didOpen: () => Swal.showLoading()
        });

        const res = await fetch('/payment/apply-coins/' + orderId, {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            }
        });

        let data = {};
        try {
            data = await res.json();
        } catch (e) {
            console.error('JSON parse error:', e);
        }

        if (res.ok && data.success) {
            Swal.fire({
                icon: 'success',
                title: 'Coins Redeemed! 🪙',
                text: 'Successfully deducted ₹' + data.coinsDeducted + ' using Nova Coins!',
                timer: 1200,
                showConfirmButton: false
            }).then(() => {
                window.location.reload();
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Could Not Apply',
                text: data.message || 'Unable to apply coins. Please refresh and try again.',
                background: '#141a29',
                color: '#fff',
                confirmButtonColor: '#00e5ff'
            });
        }
    } catch (err) {
        console.error('Fetch error:', err);
        Swal.fire({ 
            icon: 'error', 
            title: 'Error', 
            text: err.message || 'Network error occurred.',
            background: '#141a29',
            color: '#fff',
            confirmButtonColor: '#00e5ff'
        });
    }
}
</script>
